# Copy to backend/.env and tweak. Defaults are sensible for a 12 GB Windows box.

STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000
STUDIO_LOG_LEVEL=info

STUDIO_OLLAMA_HOST=http://127.0.0.1:11434
STUDIO_OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

STUDIO_IMAGE_MODEL_PRIMARY=black-forest-labs/FLUX.1-schnell
STUDIO_IMAGE_MODEL_FALLBACK=stabilityai/sdxl-turbo
STUDIO_IMAGE_WIDTH=1024
STUDIO_IMAGE_HEIGHT=576
STUDIO_IMAGE_STEPS=4

STUDIO_PIPER_VOICE_MALE=en_US-ryan-medium
STUDIO_PIPER_VOICE_FEMALE=en_US-amy-medium

STUDIO_WHISPER_MODEL=base
STUDIO_WHISPER_COMPUTE_TYPE=int8

STUDIO_VIDEO_FPS=30
STUDIO_VIDEO_WIDTH=1920
STUDIO_VIDEO_HEIGHT=1080
STUDIO_VIDEO_BITRATE=6M
