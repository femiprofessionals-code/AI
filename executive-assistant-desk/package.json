{
  "name": "executive-assistant-desk",
  "productName": "Executive Assistant Desk",
  "version": "1.1.0",
  "description": "Meetings, spoken reminders, three time-zone clocks and daily tasks for an Executive Director's assistant.",
  "main": "src/main/main.js",
  "author": "Executive Assistant Desk",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/run-e2e.js",
    "icons": "node scripts/make-icons.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:dir": "electron-builder --win dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.executiveassistantdesk.app",
    "productName": "Executive Assistant Desk",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "ExecutiveAssistantDesk"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Executive Assistant Desk",
      "runAfterFinish": true,
      "artifactName": "Executive-Assistant-Desk-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
